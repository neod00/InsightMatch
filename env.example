# Supabase PostgreSQL Database URL
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.ghyioswdnfgtijowvpeo:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Alternative Supabase DB URL format
SUPABASE_DB_URL=postgresql://postgres.ghyioswdnfgtijowvpeo:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Google Gemini API Key
GOOGLE_API_KEY=your-gemini-api-key

# DATA.go.kr 공공데이터포털 API Key (금융위원회 기업기본정보)
# https://www.data.go.kr/data/15043184/openapi.do
DATA_GO_KR_API_KEY=your-data-go-kr-api-key

# JWT Secret Key
SECRET_KEY=your-secret-key-for-jwt

# Supabase API Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Base URL (for sitemap)
BASE_URL=https://insight-match.vercel.app

# 일일 배치(/api/cron/daily) 인증용 시크릿 (16자 이상 랜덤 문자열)
# Vercel 은 이 환경변수가 있으면 cron 호출 시 Authorization: Bearer <값> 을 자동으로 붙인다.
# GitHub Actions 로 호출할 때도 같은 값을 저장소 Secret 에 넣으면 된다.
# ⚠️ 미설정 시 /api/cron/daily 는 401 로 거부한다 (관리자 JWT 로는 수동 실행 가능).
CRON_SECRET=generate-with-python-secrets-token-urlsafe-32

