# Supabase Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# You can find this in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Make sure to replace [YOUR-PASSWORD] with your actual database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google AI (Gemini) API Key
GOOGLE_API_KEY=your-google-api-key-here

# ===== Email Service Configuration =====
# Gmail 사용 시: App Password 설정 필요 (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@insightmatch.com
FROM_NAME=InsightMatch

# ===== Kakao Alimtalk (향후 사용) =====
# 사업자등록 후 카카오 비즈니스에서 발급
# KAKAO_API_KEY=your-kakao-api-key
# KAKAO_CHANNEL_ID=your-channel-id
